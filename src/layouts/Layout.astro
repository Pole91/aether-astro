---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="stylesheet" href="/styles/games.css" />
  </head>
  <body>
    <nav class="navbar">
      <h1 class="logo">🎮 Utbildningsspel för Barn</h1>
      <a href="/" class="nav-link">Hem</a>
    </nav>
    <main class="container">
      <slot />
    </main>
    <footer>
      <p>&copy; 2024 Utbildningsspel för 8-11 åringer</p>
    </footer>
  </body>
</html>
