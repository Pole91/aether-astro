---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Utbildningsspel - Hem">
  <section class="hero">
    <h2>Välkommen till Utbildningsspelen!</h2>
    <p>Lär dig nya saker medan du spelar roliga spel 🎯</p>
  </section>

  <section class="games-menu">
    <div class="game-card">
      <h3>🍎 Memory - Frukt Tema</h3>
      <p>Träna ditt minne genom att hitta matchande fruktpar!</p>
      <p class="info">Utvecklar: Minne, Fokus, Uppmärksamhet</p>
      <a href="/memory-game" class="btn-play">Spela Nu</a>
    </div>

    <div class="game-card">
      <h3>🔍 Hitta Skillnaden</h3>
      <p>Hur snabbt kan du hitta alla skillnader mellan bilderna?</p>
      <p class="info">Utvecklar: Observation, Uppmärksamhet, Snabbhet</p>
      <a href="/spot-difference" class="btn-play">Spela Nu</a>
    </div>

    <div class="game-card">
      <h3>🔢 Mattekviz</h3>
      <p>Lösa snabba mattebetydande problem och samla poäng!</p>
      <p class="info">Utvecklar: Matematik, Snabbt Tänkande, Logik</p>
      <a href="/math-quiz" class="btn-play">Spela Nu</a>
    </div>

    <div class="game-card">
      <h3>📚 Ord-Ordning</h3>
      <p>Ordna bokstäver för att skapa ordet på svenska!</p>
      <p class="info">Utvecklar: Ordförråd, Stavning, Språk</p>
      <a href="/word-game" class="btn-play">Spela Nu</a>
    </div>

    <div class="game-card">
      <h3>🌍 Geografi Quiz</h3>
      <p>Testa dina kunskaper om världens länder och städer!</p>
      <p class="info">Utvecklar: Geografikunskap, Världskunskap</p>
      <a href="/geography-quiz" class="btn-play">Spela Nu</a>
    </div>

    <div class="game-card">
      <h3>🧠 Logik Pussel</h3>
      <p>Lösa roliga logik-pussel och utmaningar!</p>
      <p class="info">Utvecklar: Logiskt Tänkande, Problemlösning</p>
      <a href="/logic-puzzle" class="btn-play">Spela Nu</a>
    </div>
  </section>
</Layout>
